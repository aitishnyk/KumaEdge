# Optional demo inside owner-gateway. Never commit a populated .env.
KUMAEDGE_DEMO_ENABLED=false
KUMAEDGE_DEMO_USERNAME=demo
# Generate in a trusted terminal with scripts/local/configure-demo.py.
KUMAEDGE_DEMO_PASSWORD_HASH=
KUMAEDGE_DEMO_SESSION_SECRET=
KUMAEDGE_DEMO_SESSION_TTL=3600
KUMAEDGE_DEMO_PUBLIC_TITLE=Service health
KUMAEDGE_PUBLIC_ORIGIN=https://mc-b4n2u1709h.bunny.run
# Existing PUBLIC Kuma status page; only listed IDs that are public are returned.
KUMAEDGE_DEMO_STATUS_PAGE=
KUMAEDGE_DEMO_SERVICES=[]

# Optional same-container encrypted owner operations (not a third container).
# Keep these only in the ignored private deployment store; age identity stays in Keychain.
KUMAEDGE_OPS_TOKEN=
KUMAEDGE_BACKUP_RECIPIENT=
# Explicit disposable-data authorization only. A stable on-volume marker prevents repetition.
KUMAEDGE_DISPOSABLE_RESET_NONCE=
KUMAEDGE_RESET_TARGET_APP_ID=
